{
  "name": "personal-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Interview-focused personal portfolio with a Vue frontend and Node API.",
  "scripts": {
    "dev": "pnpm --parallel --filter @portfolio/web --filter @portfolio/api dev",
    "build": "pnpm --filter @portfolio/web build && pnpm --filter @portfolio/api build",
    "typecheck": "pnpm --filter @portfolio/web typecheck && pnpm --filter @portfolio/api typecheck",
    "start": "pnpm --filter @portfolio/api start"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.25.0"
}
